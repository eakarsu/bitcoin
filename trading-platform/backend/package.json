{
  "name": "trading-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for Crypto Trading Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/run.js",
    "seed:demo": "node seeds/run.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test test/*.test.js",
    "security": "node scripts/audit-repository.js",
    "check": "node --check src/server.js && node --check src/routes/governedTrading.js && node --check src/governance/riskEngine.js && npm run security && npm test"
  },
  "keywords": [
    "trading",
    "crypto",
    "api",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "express-rate-limit": "^8.6.0",
    "ioredis": "^5.11.1",
    "node-cron": "^4.6.0",
    "nodemon": "^3.0.3",
    "socket.io": "^4.8.3",
    "ws": "^8.21.1"
  }
}
